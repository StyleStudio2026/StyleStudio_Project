<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Style Details"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginBottom="20dp"/>

        <ImageView
            android:id="@+id/detailImage"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:scaleType="fitCenter"
            android:contentDescription="Selected Outfit"/>

        <TextView
            android:id="@+id/detailStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Casual"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginTop="15dp"/>

        <TextView
            android:id="@+id/detailPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SAR 120"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#4936B5"
            android:layout_marginTop="15dp"/>

        <TextView
            android:id="@+id/detailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Comfortable and simple, great for daily use."
            android:textSize="16sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="25dp"/>

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Save to Favorites"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#E83E80"/>

    </LinearLayout>

</ScrollView>
